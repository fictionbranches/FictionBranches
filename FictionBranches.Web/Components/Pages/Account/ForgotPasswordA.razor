@page "/fb/account/forgotpassword"

@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@inject UserManager<Fbuser> UserManager
@inject IEmailSender<Fbuser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager


<PageTitle>Forgot your password?</PageTitle>
<h1>Forgot your password?</h1>

@if (_isPost)
{
    <p>If an account with that email exists, we've sent a reset link.</p>
}

<EditForm style="@(_isPost ? "display: none;" : "")" Model="Input" FormName="ForgotPasswordForm" method="post" OnValidSubmit="OnValidSubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-floating mb-3">
        <InputText id="Input.Email" @bind-Value="Input.Email" autofocus class="form-control" autocomplete="username" aria-required="true" />
        <label for="Input.Email" class="form-label">Email or Username</label>
    </div>
    
    <button type="submit" class="btn btn-primary">Send reset link</button>
</EditForm>


@code {
    private bool _isPost;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        
        switch (HttpContext.Request.Method.ToLower())
        {
            case "post":
                _isPost = true;
                break;
            case "get":
                _isPost = false;
                break;
            default:
                RedirectManager.RedirectTo("/fb");
                return;
        }

        if (HttpContext.User.IsLoggedIn())
            RedirectManager.RedirectTo("/fb");
    }
    
    private async Task OnValidSubmitAsync()
    {
        if (HttpContext.User.IsLoggedIn())
        {
            RedirectManager.RedirectTo("/fb");
            return;
        }
        
        var user = await UserManager.FindByEmailOrIdAsync(Input.Email);

        if (user is not null && await UserManager.IsEmailConfirmedAsync(user))
        {
            var code = await UserManager.GeneratePasswordResetTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));

            var link = NavigationManager.GetUriWithQueryParameters(
                NavigationManager.ToAbsoluteUri("/fb/account/resetforgotpassword").AbsoluteUri,
                new Dictionary<string, object?> { ["code"] = code });

            await EmailSender.SendPasswordResetLinkAsync(user, user.Email!, link);
        }
    }

    private sealed class InputModel
    {
        [ValidatingStringLength(MinLength = 4, MaxLength = 32)]
        public string Email { get; set; } = "";
    }
}

@page "/fb/account/resetforgotpassword"

@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@inject UserManager<Fbuser> UserManager
@inject IEmailSender<Fbuser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Reset your password</PageTitle>
<h1>Reset your password</h1>

<EditForm Model="Input" FormName="ResetForgotPasswordForm" method="post" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    
    <div class="form-floating mb-3">
        <InputText id="Input.Email" @bind-Value="Input.Email" autofocus class="form-control" autocomplete="username" aria-required="true" />
        <label for="Input.Email" class="form-label">Email or Username</label>
    </div>
    <div class="form-floating mb-3">
        <InputText id="Input.Password" type="password" @bind-Value="Input.Password" class="form-control" aria-required="true" />
        <label for="Input.Password" class="form-label">Password</label>
    </div>
    <div class="form-floating mb-3">
        <InputText id="Input.ConfirmPassword" type="password" @bind-Value="Input.ConfirmPassword" class="form-control" aria-required="true" />
        <label for="Input.ConfirmPassword" class="form-label">Confirm password</label>
    </div>
    
    <InputText type="hidden" Value="@Input.Token" ValueExpression="()=>Input.Token" />
    
    <button type="submit" class="btn btn-primary">Reset password</button>
</EditForm>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string? Code { get; init; }
    
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (HttpContext.User.IsLoggedIn())
        {
            RedirectManager.RedirectTo("/fb");
            return;
        }

        Input.Token = Code;
    }

    private async Task OnValidSubmit()
    {
        string token;
        try
        {
            // Reverses the Base64Url encoding applied when the link was generated
            token = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Input.Token));
        }
        catch (FormatException)
        {
            NavigationManager.NavigateTo("/fb/account/resetforgotpasswordresult?Success=false&Error=" + Uri.EscapeDataString("Invalid or expired reset code. A"));
            return;
        }
        
        var user = await UserManager.FindByEmailOrIdAsync(Input.Email);
        if (user is null)
        {
            NavigationManager.NavigateTo("/fb/account/resetforgotpasswordresult?Success=false&Error=" + Uri.EscapeDataString("Invalid or expired reset code. B"));
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, token, Input.Password);
        if (result.Succeeded)
        {
            NavigationManager.NavigateTo("/fb/account/resetforgotpasswordresult?Success=true");
            return;
        }

        NavigationManager.NavigateTo("/fb/account/resetforgotpasswordresult?Success=false&Error=" + Uri.EscapeDataString(string.Join(", ", result.Errors.Select(e => e.Description))));
    }
    
    private sealed class InputModel
    {
        [ValidatingStringLength(MinLength = 4, MaxLength = 32)]
        public string Email { get; set; } = "";
        [ValidatingStringLength(MinLength = 8, MaxLength = 128)]
        public string Password { get; set; } = "";
        [MatchingOtherString("Password", ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
        
        public string Token { get; set; } = "";
    }
}

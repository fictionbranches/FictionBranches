@page "/fb/account/resetforgotpasswordresult"

<PageTitle>Reset your password</PageTitle>
<h1>Reset your password</h1>

@if (Succeeded)
{
    <div class="alert alert-primary" role="alert">Password was successfully updated!</div>
    <p><a href="/fb/account/login">Click here</a> to log in.</p>
}
else
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
    <p><a href="/fb/account/forgotpassword">Forgot your password?</a></p>
}


@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string? Success { get; init; }
    
    [SupplyParameterFromQuery]
    public string? Error { get; init; }

    private bool Succeeded => !string.IsNullOrWhiteSpace(Success) && Success.ToLower().StartsWith("true");

    private string ErrorMessage => string.IsNullOrWhiteSpace(Error) ? "Unknown error." : Error;
}

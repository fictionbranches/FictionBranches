@page "/fb/useraccount"

@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject NavigationManager NavMan
@inject SignInManager<Fbuser> SignInManager

@attribute [Authorize]

<PageTitle>User Account Settings</PageTitle>

<h1>Modify your account</h1>

<p><a href="/fb/user/@HttpContext.User.Username()">View your account</a></p>

<hr/>

<EditForm Model="NotificationSettings" method="post" OnValidSubmit="OnValidSubmitNotificationSettings" FormName="UserAccountNotificationSettingsForm">
    
    <h3>Notification settings</h3>
    
    <DataAnnotationsValidator />
    <ValidationSummary />
    
    <div class="container-fluid">
        <div class="row">
            <div class="@LeftColumnClass">Get notified when:</div>
            <div class="@ColumnClass">on-site</div>
            <div class="@ColumnClass">email</div>
        </div>
        <div class="row">
            <div class="@LeftColumnClass">Someone comments on an episode you wrote</div>
            <div class="@ColumnClass">
                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="NotificationSettings.CommentSite" />
                </div>
            </div>
            <div class="@ColumnClass">
                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="NotificationSettings.CommentMail" />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="@LeftColumnClass">Someone writes a new child episode of an episode you wrote</div>
            <div class="@ColumnClass">
                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="NotificationSettings.ChildSite" />
                </div>
            </div>
            <div class="@ColumnClass">
                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="NotificationSettings.ChildMail" />
                </div>
            </div>
        </div>
    </div>
    
    <button type="submit" class="btn btn-primary my-3">Update notification settings</button>
</EditForm>

<EditForm Model="AuthorName" method="post" OnValidSubmit="OnValidSubmitAuthorName" FormName="AuthorNameForm">
    
    <h3>Change author name</h3>
    
    <DataAnnotationsValidator />
    <ValidationSummary />

    <InputText class="form-control" placeholder="Name" @bind-Value="AuthorName.Author" />
    <button type="submit" class="btn btn-primary my-3">Update name</button>
</EditForm>

<EditForm Model="AuthorBio" method="post" OnValidSubmit="OnValidSubmitAuthorBio" FormName="AuthorBioForm">
    
    <h3>Change author bio</h3>
    
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div id="buttonToggleGroup" class="mb-3">
        <button type="button" class="btn btn-secondary me-3" data-bs-toggle="collapse" data-bs-target="#formattingHelp" role="button"
                aria-expanded="false" aria-controls="formattingHelp">
            Formatting help
        </button>
        <button type="button" class="btn btn-secondary me-3" data-bs-toggle="collapse" data-bs-target="#previewMarkdown" role="button"
                aria-expanded="false" aria-controls="previewMarkdown">
            Preview markdown
        </button>
        <div class="my-3 collapse" data-bs-parent="#buttonToggleGroup" id="formattingHelp">
            <div class="card card-body">
                <MarkdownFormattingHelp/>
            </div>
        </div>
        <div class="my-3 collapse" data-bs-parent="#buttonToggleGroup" id="previewMarkdown">
            <div class="card card-body" id="previewDiv"></div>
        </div>
    </div>
    
    <InputTextArea class="form-control previewtext" @bind-Value="AuthorBio.Bio" />
    <button type="submit" class="btn btn-primary my-3">Update bio</button>
</EditForm>

@*
TODO:

- subscribed users
- blocked users
*@

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const bodyTextArea = document.querySelector('.previewtext');
        const previewDiv = document.getElementById('previewDiv');
        if (bodyTextArea && previewDiv) {
            const onBodyChange = () => {
                const body = bodyTextArea.value ?? "";
                previewDiv.innerHTML = '';
                const div = document.createElement('div');
                div.innerHTML = markdownToHTML(body);
                previewDiv.appendChild(div);
            };

            bodyTextArea.addEventListener('input', () => onBodyChange());
            onBodyChange();
        }
    });
</script>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private const string LeftColumnClass = "col-6 border";
    private const string ColumnClass = "col-3 col-md-2 border d-flex justify-content-center align-items-center";

    #pragma warning disable BL0008
    [SupplyParameterFromForm(FormName = "UserAccountNotificationSettingsForm")]
    private NotificationSettingsModel NotificationSettings { get; set; } = new();
    [SupplyParameterFromForm(FormName = "AuthorNameForm")]
    private AuthorNameModel AuthorName { get; set; } = new();
    [SupplyParameterFromForm(FormName = "AuthorBioForm")]
    private AuthorBioModel AuthorBio { get; set; } = new();
    #pragma warning restore BL0008
        
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        bool isPost;
        switch (HttpContext.Request.Method.ToLower())
        {
            case "post":
                isPost = true;
                break;
            case "get":
                isPost = false;
                break;
            default:
                ReloadThisPage();
                return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var user = await db.Fbusers.FindAsync(HttpContext.User.Username());
        if (user == null)
        {
            NavMan.NotFound();
            return;
        }

        if (!isPost)
        {
            NotificationSettings.CommentSite = user.Commentsite;
            NotificationSettings.CommentMail = user.Commentmail;
            NotificationSettings.ChildSite = user.Childsite;
            NotificationSettings.ChildMail = user.Childmail;

            AuthorName.Author = user.Author ?? "";

            AuthorBio.Bio = user.Bio ?? "";
        }
    }

    private async Task OnValidSubmitNotificationSettings()
    {
        if (!HttpContext.Request.Method.EqualsIgnoreCase("post"))
        {
            ReloadThisPage();
            return;
        }
        
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var user = await db.Fbusers.FindAsync(HttpContext.User.Username());
        if (user == null)
        {
            ReloadThisPage();
            return;
        }
        
        user.Commentsite = NotificationSettings.CommentSite;
        user.Commentmail = NotificationSettings.CommentMail;
        user.Childsite = NotificationSettings.ChildSite;
        user.Childmail = NotificationSettings.ChildMail;
        
        await db.SaveChangesAsync();

        ReloadThisPage();
    }
    
    private async Task OnValidSubmitAuthorName()
    {
        if (!HttpContext.Request.Method.EqualsIgnoreCase("post"))
        {
            ReloadThisPage();
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var user = await db.Fbusers.FindAsync(HttpContext.User.Username());
        if (user == null)
        {
            ReloadThisPage();
            return;
        }

        user.Author = AuthorName.Author;
        await db.SaveChangesAsync();
        
        // refresh claims
        await SignInManager.RefreshSignInAsync(user);

        ReloadThisPage();
    }
    
    private async Task OnValidSubmitAuthorBio()
    {
        if (!HttpContext.Request.Method.EqualsIgnoreCase("post"))
        {
            ReloadThisPage();
            return;
        }

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var user = await db.Fbusers.FindAsync(HttpContext.User.Username());
        if (user == null)
        {
            ReloadThisPage();
            return;
        }

        user.Bio = AuthorBio.Bio;
        await db.SaveChangesAsync();

        ReloadThisPage();
    }
    
    private void ReloadThisPage() => NavMan.NavigateTo($"/fb/useraccount");
    
    private sealed class NotificationSettingsModel
    {
        public bool CommentSite { get; set; }
        public bool CommentMail { get; set; }
        public bool ChildSite { get; set; }
        public bool ChildMail { get; set; }
    }
    
    private sealed class AuthorNameModel
    {
        [ValidatingStringLength(MinLength = 1, MaxLength = 32)]
        public string Author { get; set; } = "";
    }
    
    private sealed class AuthorBioModel
    {
        [ValidatingStringLength(MinLength = 0, MaxLength = 10000)]
        public string Bio { get; set; } = "";
    }
}